# Xentral MCP Server - Environment Configuration Template

# API Configuration (REQUIRED)
# Base URL of your Xentral instance WITHOUT /api suffix,
# e.g. https://mycompany.xentral.biz
XENTRAL_API_URL=https://your-company.xentral.biz
# Personal access token / API key (sent as Bearer token)
XENTRAL_API_KEY=your_api_key_here

# Server Configuration (OPTIONAL)
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8888

# Debug & Logging (OPTIONAL)
MCP_DEBUG=false
LOG_LEVEL=INFO
LOG_REQUESTS=true
