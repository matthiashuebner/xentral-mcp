# Xentral MCP Server - Environment Configuration Template

# API Configuration (REQUIRED)
# Base URL of your Xentral instance WITHOUT /api suffix, e.g.
# https://mycompany.xentral.biz  (must be https unless it is localhost)
XENTRAL_API_URL=https://your-company.xentral.biz
# Personal access token / API key (sent as Bearer token to Xentral)
XENTRAL_API_KEY=your_api_key_here

# Optional SSRF allow-list: comma-separated hostnames the API URL may use.
# When set, only these hosts (or their subdomains) are accepted.
# XENTRAL_ALLOWED_HOSTS=your-company.xentral.biz

# Authentication (REQUIRED to bind anywhere other than 127.0.0.1)
# Shared secret clients must send as `Authorization: Bearer <token>`.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# OAuth 2.1 (only needed for remote MCP clients such as Claude's connectors,
# which have no field for a static bearer token and authenticate by discovery)
# ---------------------------------------------------------------------------
# Leave false and nothing below applies; the server behaves exactly as before.
MCP_OAUTH_ENABLED=false

# Externally reachable base URL — this is the OAuth issuer, so it must be the
# exact URL the client connects to (no trailing slash). https is mandatory
# unless the host is localhost. Required when MCP_OAUTH_ENABLED=true.
MCP_PUBLIC_URL=https://mcp.your-company.example

# Password you type into the consent screen to approve a connection. This is the
# only gate on the OAuth flow — make it long. Minimum 12 characters.
MCP_OAUTH_PASSWORD=

# Where registered clients, authorization codes and refresh tokens are stored.
# Must be on persistent, writable storage shared by all gunicorn workers.
MCP_OAUTH_DB_PATH=oauth-store.sqlite3

# Optional: restrict which hosts a client may be redirected back to, e.g.
# "claude.ai,claude.com". Loopback redirects stay allowed for desktop clients.
# MCP_OAUTH_ALLOWED_REDIRECT_HOSTS=

# Optional tuning. Access tokens are stateless and cannot be revoked before they
# expire, so keep the TTL short; refresh tokens are stored and rotate on use.
# MCP_OAUTH_ACCESS_TOKEN_TTL=3600
# MCP_OAUTH_REFRESH_TOKEN_TTL=2592000
# MCP_OAUTH_MAX_CLIENTS=50
# Optional: pin the token signing key (>=32 chars). Left empty, the server
# generates one and persists it in the store — right for a single-host setup.
# MCP_OAUTH_SIGNING_KEY=

# Server Configuration (OPTIONAL)
# Defaults to loopback only. Do NOT set 0.0.0.0 without also setting
# MCP_AUTH_TOKEN and placing the server behind a TLS-terminating proxy.
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8888

# Logging (OPTIONAL). Request bodies are never logged with values; only
# method, tool name and argument keys are recorded.
LOG_LEVEL=INFO
LOG_REQUESTS=true
